# Copy to .env and adjust. .env must be in .gitignore.

POSTGRES_DB=wavedb
POSTGRES_USER=wave
POSTGRES_PASSWORD=wave_dev_password

# Spring reads these
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wavedb
SPRING_DATASOURCE_USERNAME=wave
SPRING_DATASOURCE_PASSWORD=wave_dev_password

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Open-Meteo needs no key. Base URLs kept configurable for testing/mocking.
OPENMETEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
